# Scaffolded by `flisk resource`. `flisk up` does NOT build this file: it builds
# .autogenerated/Dockerfile.app.autogenerated (golden layers, project root as context).
# The site itself is static and goes to GitHub Pages (.github/workflows/deploy.yml); this image is the local
# preview only. Keep its port in step with "port" in service.json.
FROM oven/bun:1.4-slim

WORKDIR /app
COPY package.json bun.lock* ./
RUN bun install
COPY . .

HEALTHCHECK --interval=10s --timeout=5s --retries=3 \
  CMD bun -e "fetch('http://localhost:4000/health').then((r) => process.exit(r.ok ? 0 : 1), () => process.exit(1))"

ENV PORT=4000
EXPOSE 4000
CMD ["bun", "src/index.ts"]
