{
  "version": "1.0",
  "project": {
    "name": "flisk-template-launch",
    "version": "1.0.0"
  },
  "phases": {
    "pre_alpha": {
      "name": "Pre-Alpha",
      "description": "Core infrastructure and MVP services",
      "enabledStacks": [
        "proxy",
        "app"
      ]
    },
    "alpha": {
      "name": "Alpha",
      "description": "Essential business services",
      "enabledStacks": []
    },
    "beta": {
      "name": "Beta",
      "description": "Extended features",
      "enabledStacks": []
    },
    "out_of_scope": {
      "name": "Out of Scope",
      "description": "Future releases",
      "enabledStacks": []
    }
  },
  "always_enabled_infra": [
    "proxy"
  ],
  "optional_infra": {
    "monitoring": false,
    "elk": false,
    "debezium": false,
    "golden_image": true,
    "verdaccio": false
  },
  "discovery": {
    "paths": [
      "services/*/*"
    ]
  },
  "overrides": {}
}
